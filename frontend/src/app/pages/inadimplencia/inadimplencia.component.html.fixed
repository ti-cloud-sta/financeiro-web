<div class="page-container">
  <div class="main-layout">

    <!-- Sidebar -->
    <aside class="main-sidebar" [class.collapsed]="isSidebarCollapsed">
      <div class="sidebar-header d-flex justify-content-end mb-3 pb-2 border-bottom">
        <button class="btn btn-sm text-muted sidebar-toggle" (click)="toggleSidebar()" style="background: transparent; border: none; padding: 0.25rem 0.5rem; border-radius: 6px;">
          <i class="fa-solid" [ngclass]="isSidebarCollapsed ? 'fa-chevron-right' : 'fa-chevron-left'"></i>
        </button>
      </div>

      <ul class="main-nav">
        <li>
          <button class="main-nav-link" [class.active]="activeTab === 'dashboards'" (click)="setActiveTab('dashboards')" title="Dashboards">
            <i class="fa-solid fa-chart-line"></i> <span class="nav-text">Dashboards</span>
          </button>
        </li>
        <li>
          <button class="main-nav-link" [class.active]="activeTab === 'pendencias'" (click)="setActiveTab('pendencias')" title="Pendências">
            <i class="fa-solid fa-triangle-exclamation"></i> <span class="nav-text">Pendências</span>
          </button>
        </li>
        <li>
          <button class="main-nav-link" [class.active]="activeTab === 'atualizacao-dados'" (click)="setActiveTab('atualizacao-dados')" title="Atualização de Dados">
            <i class="fa-solid fa-database"></i> <span class="nav-text">Atualização de Dados</span>
          </button>
        </li>
      </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <div class="tab-content custom-tab-content">

        <!-- Tab Dashboards -->
        <div class="tab-pane fade" [class.show]="activeTab === 'dashboards'" [class.active]="activeTab === 'dashboards'" role="tabpanel">
          <div class="config-layout">
            <div class="dashboard-header d-flex justify-content-between align-items-center border-bottom pt-2">
              <ul class="config-nav mb-0 border-bottom-0 pb-0 px-3">
                <li class="config-nav-item">
                  <button class="config-nav-link" [class.active]="dashboardTab() === 'visao-geral'" (click)="setDashboardTab('visao-geral')">
                    Visão Geral
                  </button>
                </li>
                <li class="config-nav-item">
                  <button class="config-nav-link" [class.active]="dashboardTab() === 'financeiro'" (click)="setDashboardTab('financeiro')">
                    Financeiro
                  </button>
                </li>
                <li class="config-nav-item">
                  <button class="config-nav-link" [class.active]="dashboardTab() === 'logistica'" (click)="setDashboardTab('logistica')">
                    Logística
                  </button>
                </li>
                <li class="config-nav-item">
                  <button class="config-nav-link" [class.active]="dashboardTab() === 'comercial'" (click)="setDashboardTab('comercial')">
                    Comercial
                  </button>
                </li>
              </ul>
            </div>
            <main class="dashboard-content px-2 pb-3 pt-0 px-md-4 pb-md-4 pt-md-1" style="flex-grow: 1;">


              <!-- SKELETON LOADING -->
              <div *ngif="isDashboardLoading()">
                <!-- SKELETON: VISÃO GERAL -->
                <div *ngif="dashboardTab() === 'visao-geral'">
                  <div class="dash-kpi-panel border rounded-4 p-4 mb-4 border-2">
                    <div class="d-flex justify-content-between align-items-center mb-3 ms-1">
                      <h5 class="fw-bold text-secondary mb-0">Financeiro</h5>
                      <div class="bg-light border px-3 py-2 rounded-3 d-flex align-items-center gap-3">
                        <app-skeleton type="text" width="100px" height="16px"></app-skeleton>
                        <div class="vr text-secondary opacity-25 mx-1" style="height: 16px;"></div>
                        <app-skeleton type="text" width="120px" height="16px"></app-skeleton>
                        <app-skeleton type="text" width="120px" height="16px"></app-skeleton>
                      </div>
                    </div>
                    <div class="row g-4">
                      <div class="col-12 col-xl-4">
                        <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm"><app-skeleton type="text" width="60%" height="18px" class="mb-3"></app-skeleton><app-skeleton type="rect" width="100%" height="250px"></app-skeleton></div>
                      </div>
                      <div class="col-12 col-xl-4">
                        <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm"><app-skeleton type="text" width="60%" height="18px" class="mb-3"></app-skeleton><app-skeleton type="rect" width="100%" height="250px"></app-skeleton></div>
                      </div>
                      <div class="col-12 col-xl-4">
                        <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm"><app-skeleton type="text" width="60%" height="18px" class="mb-3"></app-skeleton><app-skeleton type="rect" width="100%" height="250px"></app-skeleton></div>
                      </div>
                    </div>
                  </div>
                  <div class="dash-kpi-panel border rounded-4 p-4 mb-4 border-2">
                    <div class="d-flex justify-content-between align-items-center mb-3 ms-1">
                      <h5 class="fw-bold text-secondary mb-0">Logística</h5>
                      <div class="bg-light border px-3 py-2 rounded-3 d-flex align-items-center gap-3">
                        <app-skeleton type="text" width="100px" height="16px"></app-skeleton>
                        <div class="vr text-secondary opacity-25 mx-1" style="height: 16px;"></div>
                        <app-skeleton type="text" width="120px" height="16px"></app-skeleton>
                        <app-skeleton type="text" width="120px" height="16px"></app-skeleton>
                      </div>
                    </div>
                    <div class="row g-4">
                      <div class="col-12 col-xl-6">
                        <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm"><app-skeleton type="text" width="40%" height="18px" class="mb-3"></app-skeleton><app-skeleton type="rect" width="100%" height="250px"></app-skeleton></div>
                      </div>
                      <div class="col-12 col-xl-6">
                        <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm"><app-skeleton type="text" width="40%" height="18px" class="mb-3"></app-skeleton><app-skeleton type="rect" width="100%" height="250px"></app-skeleton></div>
                      </div>
                    </div>
                  </div>
                  <div class="dash-kpi-panel border rounded-4 p-4 mb-4 border-2">
                    <div class="d-flex justify-content-between align-items-center mb-3 ms-1">
                      <h5 class="fw-bold text-secondary mb-0">Comercial</h5>
                      <div class="bg-light border px-3 py-2 rounded-3 d-flex align-items-center gap-3">
                        <app-skeleton type="text" width="100px" height="16px"></app-skeleton>
                        <div class="vr text-secondary opacity-25 mx-1" style="height: 16px;"></div>
                        <app-skeleton type="text" width="150px" height="16px"></app-skeleton>
                      </div>
                    </div>
                    <div class="row g-4">
                      <div class="col-12 col-xl-6">
                        <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm"><app-skeleton type="text" width="50%" height="18px" class="mb-3"></app-skeleton><app-skeleton type="rect" width="100%" height="280px"></app-skeleton></div>
                      </div>
                      <div class="col-12 col-xl-6">
                        <div class="row g-4">
                          <div class="col-12">
                            <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm d-flex flex-column align-items-center justify-content-center" style="height: 120px;"><app-skeleton type="text" width="60%" height="14px" class="mb-2"></app-skeleton><app-skeleton type="rect" width="40%" height="32px"></app-skeleton></div>
                          </div>
                          <div class="col-12">
                            <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm" style="height: 140px;">
                              <app-skeleton type="text" width="40%" height="18px" class="mb-3"></app-skeleton><app-skeleton type="rect" width="100%" height="80px"></app-skeleton>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- SKELETON: FINANCEIRO -->

                <div *ngif="dashboardTab() === 'financeiro'">
                  <div class="dash-kpi-panel p-3 mb-4 border rounded-3 bg-white">
                    <div class="row g-4 mb-4">
                      <div class="col-12">
                        <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm">
                          <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0 fw-semibold text-secondary">
                              Títulos Financeiros
                              <span class="badge bg-light text-secondary ms-2 border fw-normal">{{ gridFinanceiro.length }}</span>
                            </h6>
                            <div class="config-toolbar mb-0">
                              <div class="search-box">
                                <i class="fa-solid fa-search text-muted position-absolute" style="left: 10px; top: 50%; transform: translateY(-50%);"></i>
                                <input type="text" class="form-control form-control-sm" placeholder="Buscar..." [(ngmodel)]="searchFinanceiro" (ngmodelchange)="pageFinanceiro = 1" style="padding-left: 28px;">
                              </div>
                            </div>
                          </div>
                          <table class="saas-table w-100 mt-2">
                            <thead>
                              <tr>
                                <th>Título</th>
                                <th>Cliente</th>
                                <th>Fase</th>
                                <th>Vencimento</th>
                                <th>Status</th>
                                <th class="text-center">Atraso</th>
                                <th class="text-end">Valor</th>
                                <th class="text-center">Tratativas/Histórico</th>
                              </tr>
                            </thead>
                            <tbody>
                                 <tr *ngfor="let t of paginatedFinanceiro">
                                   <td>{{ t.titulo }}</td>
                                   <td>{{ t.cliente }}</td>
                                   <td><span class="badge rounded-pill bg-light text-secondary border fw-normal">{{ t.fase }}</span></td>
                                   <td>{{ t.vencimento | date:'dd/MM/yyyy' }}</td>
                                   <td><span class="badge status-badge bg-{{t.statusColor}} bg-opacity-10 text-{{t.statusColor}}">{{ t.status }}</span></td>
                                   <td class="text-center">
                                     <span *ngif="t.diasAtraso !== null" class="badge rounded-pill px-2 py-1 fw-normal" [ngclass]="{
                                         'bg-danger bg-opacity-10 text-danger border border-danger-subtle': t.diasAtraso > 30,
                                         'bg-warning bg-opacity-10 text-warning border border-warning-subtle': t.diasAtraso > 5 && t.diasAtraso <= 30,
                                         'bg-secondary bg-opacity-10 text-secondary border': t.diasAtraso <= 5
                                       }">
                                       {{ t.diasAtraso }}d
                                     </span>
                                   </td>
                                   <td class="text-end"><span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1">{{
                                       t.valor | currency:'BRL' }}</span></td>
                                   <td class="text-center">
                                     <button class="btn btn-sm btn-light text-secondary border-0 p-1 me-1" title="Visualizar tratativas" (click)="abrirTratativas(t)">
                                       <i class="fa-regular fa-comments" style="font-size: 1.1rem;"></i>
                                     </button>
                                     <button class="btn btn-sm btn-light text-secondary border-0 p-1" title="Visualizar Histórico" (click)="abrirHistorico(t)">
                                       <i class="fa-solid fa-clock-rotate-left" style="font-size: 1.1rem;"></i>
                                     </button>
                                   </td>
                                 </tr>
                                 <tr *ngif="paginatedFinanceiro.length === 0">
                                   <td colspan="8" class="text-center text-muted py-3">Nenhum título encontrado.</td>
                                 </tr>
                               </tbody>
                             </table>
                             <nav aria-label="Page navigation" class="mt-3" *ngif="totalPagesFinanceiro > 1">
                               <ul class="pagination pagination-sm justify-content-end mb-0">
                                 <li class="page-item" [class.disabled]="pageFinanceiro === 1">
                                   <button class="page-link" (click)="pageFinanceiro = pageFinanceiro - 1">Anterior</button>
                                 </li>
                                 <li class="page-item disabled"><span class="page-link">Pág {{pageFinanceiro}} de {{totalPagesFinanceiro}}</span></li>
                                 <li class="page-item" [class.disabled]="pageFinanceiro === totalPagesFinanceiro">
                                   <button class="page-link" (click)="pageFinanceiro = pageFinanceiro + 1">Próxima</button>
                                 </li>
                               </ul>
                             </nav>
                           </div>
                         </div>
                       </div>
                     </div>
                   </div> <!-- Fim grid financeiro -->
                 </div>
               </main></div>
             </div></div></main>
           </div>
         </div>

         <!-- Tab Logística -->
         <div *ngif="dashboardTab() === 'logistica'">
           <div class="config-layout">
             <div class="dashboard-header border-bottom">
               <h3 class="mb-0 p-3" style="font-size: 1.5rem; font-weight: 600;">Logística</h3>
             </div>
             <div class="panel-container">
               <div class="dash-kpi-panel p-3 mb-4 border rounded-3 bg-white">
                 <div class="row g-3 mb-4">
                   <div class="col-6 col-md-3">
                     <div class="p-3 border rounded-3 bg-white">
                       <div class="text-muted small mb-1">Sem Data de Entrega</div>
                       <div class="fw-bold fs-5 text-warning">{{ kpiSemEntrega | currency:'BRL' }}</div>
                     </div>
                   </div>
                   <div class="col-6 col-md-3">
                     <div class="p-3 border rounded-3 bg-white">
                       <div class="text-muted small mb-1">Devoluções</div>
                       <div class="fw-bold fs-5 text-danger">{{ kpiDevolucao | currency:'BRL' }}</div>
                     </div>
                   </div>
                 </div>

                 <!-- Grid Sem Entrega -->
                 <div class="row g-4 mb-4">
                   <div class="col-12">
                     <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm">
                       <div class="d-flex justify-content-between align-items-center mb-3">
                         <h6 class="mb-0 fw-semibold text-secondary">
                           Sem Data de Entrega — Vencidos
                           <span class="badge bg-light text-secondary ms-2 border fw-normal">{{ gridSemEntrega.length }}</span>
                         </h6>
                         <div class="config-toolbar mb-0">
                           <div class="search-box">
                             <i class="fa-solid fa-search text-muted position-absolute" style="left: 10px; top: 50%; transform: translateY(-50%);"></i>
                             <input type="text" class="form-control form-control-sm" placeholder="Buscar..." [(ngmodel)]="searchSemEntrega" (ngmodelchange)="pageSemEntrega = 1" style="padding-left: 28px;">
                           </div>
                         </div>
                       </div>
                       <table class="saas-table w-100 mt-2">
                         <thead>
                           <tr>
                             <th>Título</th>
                             <th>Cliente</th>
                             <th>Vencimento</th>
                             <th class="text-end">Valor</th>
                             <th class="text-center">Tratativas/Histórico</th>
                           </tr>
                         </thead>
                         <tbody>
                           <tr *ngfor="let t of paginatedSemEntrega">
                             <td>{{ t.titulo }}</td>
                             <td>{{ t.cliente }}</td>
                             <td>{{ t.vencimento | date:'dd/MM/yyyy' }}</td>
                             <td class="text-end"><span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning-subtle px-2 py-1">{{ t.valor | currency:'BRL' }}</span></td>
                             <td class="text-center">
                               <button class="btn btn-sm btn-light text-secondary border-0 p-1 me-1" title="Tratativas" (click)="abrirTratativas(t)">
                                 <i class="fa-regular fa-comments" style="font-size: 1.1rem;"></i>
                               </button>
                               <button class="btn btn-sm btn-light text-secondary border-0 p-1" title="Histórico" (click)="abrirHistorico(t)">
                                 <i class="fa-solid fa-clock-rotate-left" style="font-size: 1.1rem;"></i>
                               </button>
                             </td>
                           </tr>
                           <tr *ngif="paginatedSemEntrega.length === 0">
                             <td colspan="5" class="text-center text-muted py-3">Nenhum título encontrado.</td>
                           </tr>
                         </tbody>
                       </table>
                       <nav aria-label="Page navigation" class="mt-3" *ngif="totalPagesSemEntrega > 1">
                         <ul class="pagination pagination-sm justify-content-end mb-0">
                           <li class="page-item" [class.disabled]="pageSemEntrega === 1">
                             <button class="page-link" (click)="pageSemEntrega = pageSemEntrega - 1">Anterior</button>
                           </li>
                           <li class="page-item disabled"><span class="page-link">Pág {{pageSemEntrega}} de {{totalPagesSemEntrega}}</span></li>
                           <li class="page-item" [class.disabled]="pageSemEntrega === totalPagesSemEntrega">
                             <button class="page-link" (click)="pageSemEntrega = pageSemEntrega + 1">Próxima</button>
                           </li>
                         </ul>
                       </nav>
                     </div>
                   </div>
                 </div>

                 <!-- Grid Devoluções -->
                 <div class="row g-4">
                   <div class="col-12">
                     <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm">
                       <div class="d-flex justify-content-between align-items-center mb-3">
                         <h6 class="mb-0 fw-semibold text-secondary">
                           Devoluções — Vencidos
                           <span class="badge bg-light text-secondary ms-2 border fw-normal">{{ gridDevolucao.length }}</span>
                         </h6>
                         <div class="config-toolbar mb-0">
                           <div class="search-box">
                             <i class="fa-solid fa-search text-muted position-absolute" style="left: 10px; top: 50%; transform: translateY(-50%);"></i>
                             <input type="text" class="form-control form-control-sm" placeholder="Buscar..." [(ngmodel)]="searchDevolucao" (ngmodelchange)="pageDevolucao = 1" style="padding-left: 28px;">
                           </div>
                         </div>
                       </div>
                       <table class="saas-table w-100 mt-2">
                         <thead>
                           <tr>
                             <th>Título</th>
                             <th>Cliente</th>
                             <th>Vencimento</th>
                             <th class="text-end">Valor</th>
                             <th class="text-center">Tratativas/Histórico</th>
                           </tr>
                         </thead>
                         <tbody>
                           <tr *ngfor="let t of paginatedDevolucao">
                             <td>{{ t.titulo }}</td>
                             <td>{{ t.cliente }}</td>
                             <td>{{ t.vencimento | date:'dd/MM/yyyy' }}</td>
                             <td class="text-end"><span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1">{{ t.valor | currency:'BRL' }}</span></td>
                             <td class="text-center">
                               <button class="btn btn-sm btn-light text-secondary border-0 p-1 me-1" title="Tratativas" (click)="abrirTratativas(t)">
                                 <i class="fa-regular fa-comments" style="font-size: 1.1rem;"></i>
                               </button>
                               <button class="btn btn-sm btn-light text-secondary border-0 p-1" title="Histórico" (click)="abrirHistorico(t)">
                                 <i class="fa-solid fa-clock-rotate-left" style="font-size: 1.1rem;"></i>
                               </button>
                             </td>
                           </tr>
                           <tr *ngif="paginatedDevolucao.length === 0">
                             <td colspan="5" class="text-center text-muted py-3">Nenhum título encontrado.</td>
                           </tr>
                         </tbody>
                       </table>
                       <nav aria-label="Page navigation" class="mt-3" *ngif="totalPagesDevolucao > 1">
                         <ul class="pagination pagination-sm justify-content-end mb-0">
                           <li class="page-item" [class.disabled]="pageDevolucao === 1">
                             <button class="page-link" (click)="pageDevolucao = pageDevolucao - 1">Anterior</button>
                           </li>
                           <li class="page-item disabled"><span class="page-link">Pág {{pageDevolucao}} de {{totalPagesDevolucao}}</span></li>
                           <li class="page-item" [class.disabled]="pageDevolucao === totalPagesDevolucao">
                             <button class="page-link" (click)="pageDevolucao = pageDevolucao + 1">Próxima</button>
                           </li>
                         </ul>
                       </nav>
                     </div>
                   </div>
                 </div>
               </div>
             </div>
           </div>
         </div>

         <!-- Tab Comercial -->
         <div *ngif="dashboardTab() === 'comercial'">
           <div class="config-layout">
             <div class="dashboard-header border-bottom">
               <h3 class="mb-0 p-3" style="font-size: 1.5rem; font-weight: 600;">Comercial</h3>
             </div>
             <div class="panel-container">
               <div class="dash-kpi-panel p-3 mb-4 border rounded-3 bg-white">
                 <div class="row g-4">
                   <div class="col-12">
                     <div class="dash-chart-card p-3 bg-white border rounded-3 shadow-sm">
                       <div class="d-flex justify-content-between align-items-center mb-3">
                         <h6 class="mb-0 fw-semibold text-secondary">
                           Títulos em Acordo
                           <span class="badge bg-light text-secondary ms-2 border fw-normal">{{ gridAcordos.length }}</span>
                         </h6>
                         <div class="config-toolbar mb-0">
                           <div class="search-box">
                             <i class="fa-solid fa-search text-muted position-absolute" style="left: 10px; top: 50%; transform: translateY(-50%);"></i>
                             <input type="text" class="form-control form-control-sm" placeholder="Buscar..." [(ngmodel)]="searchAcordos" (ngmodelchange)="pageAcordos = 1" style="padding-left: 28px;">
                           </div>
                         </div>
                       </div>
                       <table class="saas-table w-100 mt-2">
                         <thead>
                           <tr>
                             <th>Título</th>
                             <th>Cliente</th>
                             <th>Vencimento</th>
                             <th>Status</th>
                             <th class="text-end">Valor</th>
                             <th class="text-center">Tratativas/Histórico</th>
                           </tr>
                         </thead>
                         <tbody>
                           <tr *ngfor="let ga of paginatedAcordos">
                             <td>{{ ga.titulo }}</td>
                             <td>{{ ga.cliente }}</td>
                             <td>{{ ga.vencimento | date:'dd/MM/yyyy' }}</td>
                             <td><span class="badge status-badge bg-{{ga.statusColor}} bg-opacity-10 text-{{ga.statusColor}}">{{ ga.status }}</span></td>
                             <td class="text-end"><span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-1">{{ ga.valor | currency:'BRL' }}</span></td>
                             <td class="text-center">
                               <button class="btn btn-sm btn-light text-secondary border-0 p-1 me-1" title="Tratativas" (click)="abrirTratativas(ga)">
                                 <i class="fa-regular fa-comments" style="font-size: 1.1rem;"></i>
                               </button>
                               <button class="btn btn-sm btn-light text-secondary border-0 p-1" title="Histórico" (click)="abrirHistorico(ga)">
                                 <i class="fa-solid fa-clock-rotate-left" style="font-size: 1.1rem;"></i>
                               </button>
                             </td>
                           </tr>
                           <tr *ngif="paginatedAcordos.length === 0">
                             <td colspan="6" class="text-center text-muted py-3">Nenhum título encontrado.</td>
                           </tr>
                         </tbody>
                       </table>
                       <nav aria-label="Page navigation" class="mt-3" *ngif="totalPagesAcordos > 1">
                         <ul class="pagination pagination-sm justify-content-end mb-0">
                           <li class="page-item" [class.disabled]="pageAcordos === 1">
                             <button class="page-link" (click)="pageAcordos = pageAcordos - 1">Anterior</button>
                           </li>
                           <li class="page-item disabled"><span class="page-link">Pág {{pageAcordos}} de {{totalPagesAcordos}}</span></li>
                           <li class="page-item" [class.disabled]="pageAcordos === totalPagesAcordos">
                             <button class="page-link" (click)="pageAcordos = pageAcordos + 1">Próxima</button>
                           </li>
                         </ul>
                       </nav>
                     </div>
                   </div>
                 </div>
               </div>
             </div>
           </div>
         </div>


               <!-- END panel-container -->
            
          
        

        <!-- Tab Pendências -->
        <div class="tab-pane fade" [class.show]="activeTab === 'pendencias'" [class.active]="activeTab === 'pendencias'" role="tabpanel">
          <div class="config-layout">
            <div class="dashboard-header border-bottom">
              <h3 class="mb-0 p-3" style="font-size: 1.5rem; font-weight: 600;">Pendências</h3>
            </div>
            <div class="">
              <!-- Conteúdo de Pendências virá aqui -->
              <app-pendencias></app-pendencias>
            </div>
          </div>
        </div>

        <!-- Tab Atualização de Dados -->
        <div class="tab-pane fade" [class.show]="activeTab === 'atualizacao-dados'" [class.active]="activeTab === 'atualizacao-dados'" role="tabpanel">
          <div class="panel-container pt-0">

            <!-- Upload Box Card -->
            <div class="import-card-premium">
              <div class="import-card-header">
                <div class="import-card-icon">
                  <i class="fa-solid fa-database"></i>
                </div>
                <div class="import-card-meta">
                  <h3>Atualização de Dados</h3>
                  <p>Carregue a planilha correspondente para atualizar as informações do sistema.</p>
                </div>
              </div>

              <div class="upload-fields-row mb-3">
                <div class="upload-field-box">
                  <label class="form-label">Planilha de Atualização (Excel)</label>
                  <input type="file" #atualizacaofileinput (change)="onFileSelectedAtualizacao($event)" accept=".xlsx,.xls,.csv" style="display: none;">
                  <div class="custom-upload-zone" (click)="triggerUploadAtualizacao()" [class.has-file]="selectedFileAtualizacao() !== null" [style.pointer-events]="isImportandoDados() ? 'none' : 'auto'" [style.opacity]="isImportandoDados() ? '0.6' : '1'">
                    @if (selectedFileAtualizacao()) {
                    <i class="fa-regular fa-file-excel fs-3 text-success"></i>
                    <div class="upload-text">
                      <span class="file-selected-name text-success">{{ selectedFileAtualizacao()?.name }}</span>
                      <span class="d-block text-muted mt-1" style="font-size: 11px;">Planilha carregada! Clique em
                        "Atualizar Dados" para processar.</span>
                    </div>
                    } @else {
                    <i class="fa-regular fa-file-excel fs-3 text-success"></i>
                    <div class="upload-text">
                      <span>Carregar Planilha de Atualização</span>
                    </div>
                    }
                  </div>
                </div>
              </div>

      <div class="import-actions-row d-flex align-items-center">
        <app-button variant="primary" icon="fa-solid fa-arrows-rotate" [disabled]="!selectedFileAtualizacao() || isImportandoDados()" [loading]="isImportandoDados()" (clicked)="processarAtualizacaoDados()">
          {{ isImportandoDados() ? 'Importando...' : 'Atualizar Dados' }}
        </app-button>
        @if (isImportandoDados()) {
        <div class="progress-container flex-grow-1 ms-4" style="max-width: 400px;">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-primary fw-semibold small" style="font-size: 0.85rem;">{{ importacaoProgressMsg()
              }}</span>
            <span class="text-primary fw-bold small" style="font-size: 0.85rem;">{{ importacaoProgressPercent()
              }}%</span>
          </div>
          <div class="progress" style="height: 10px; border-radius: 8px; background-color: rgba(13, 110, 253, 0.1);">
            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" [style.width]="importacaoProgressPercent() + '%'" style="border-radius: 8px;">
            </div>
          </div>
        </div>
        }
      </div>
    </div>

            <!-- Atualizações History Header -->
            <div class="section-header d-flex justify-content-between align-items-center mb-3 mt-5">
              <div>
                <h3>Últimas Atualizações Realizadas</h3>
                <p>Acompanhe os arquivos de atualização de dados processados recentemente.</p>
              </div>
              <div class="search-box" style="max-width: 300px; width: 100%;">
                <i class="fa-solid fa-search text-muted"></i>
                <input type="text" placeholder="Buscar atualização..." [ngmodel]="searchAtualizacao()" (ngmodelchange)="searchAtualizacao.set($event)">
              </div>
            </div>

            <!-- Atualizações History Table (SaaS Style) -->
            <div class="table-card mb-5">
              <div class="table-responsive">
                <table class="saas-table">
                  <thead>
                    <tr>
                      <th style="width: 18%;">Data/Hora</th>
                      <th style="width: 52%;">Arquivo de Origem</th>
                      <th style="width: 15%;">Tipo</th>
                      <th style="width: 10%;">Usuário</th>
                      <th style="width: 5%; text-align: center;">Ações</th>
                    </tr>
                  </thead>
                  <tbody>
            @for (history of filteredAtualizacaoHistory(); track history.idImportacoes) {
            <tr>
              <td class="font-monospace small">{{ formatarData(history.createdAt) }}</td>
              <td>
                <div class="file-cell">
                  <i class="fa-regular fa-file-excel text-success fs-5" *ngif="history.nomeArquivo.endsWith('.xlsx') || history.nomeArquivo.endsWith('.xls') || history.nomeArquivo.endsWith('.csv')"></i>
                  <i class="fa-regular fa-file text-muted fs-5" *ngif="!history.nomeArquivo.endsWith('.xlsx') && !history.nomeArquivo.endsWith('.xls') && !history.nomeArquivo.endsWith('.csv')"></i>
                  <span>{{ history.nomeArquivo }}</span>
                </div>
              </td>
              <td class="text-muted small">{{ history.tipo }}</td>
              <td>
                <span class="text-muted small fw-medium text-nowrap">
                  <i class="fa-regular fa-user me-1"></i>{{ history.autor || '-' }}
                </span>
              </td>
              <td class="text-center">
                <div class="actions-cell justify-content-center">
                  <button class="action-btn delete-btn" title="Excluir" (click)="excluirAtualizacao(history.idImportacoes)">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
            }
                    @if (filteredAtualizacaoHistory().length === 0) {
                    <tr>
                      <td colspan="5" class="text-center py-4 text-muted">
                        Nenhuma atualização encontrada.
                      </td>
                    </tr>
                    }
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

      
    
  


<!-- Modal Tratativas -->
<app-modal [isopen]="isTratativasModalOpen" [title]="'Tratativas - Título ' + (tituloSelecionadoTratativas?.titulo || '')" size="md" (closed)="fecharTratativas()">

  <div class="p-2">
    <div *ngif="tituloSelecionadoTratativas" class="mb-4 pb-3 border-bottom">
      <div class="row text-muted" style="font-size: 0.9rem;">
        <div class="col-6">
          <strong class="text-dark">Cliente:</strong> {{ tituloSelecionadoTratativas.cliente }}
        </div>
        <div class="col-6 text-end">
          <strong class="text-dark">Vencimento:</strong> {{ tituloSelecionadoTratativas.vencimento |
          date:'dd/MM/yyyy' }}
        </div>
        <div class="col-6 mt-2">
          <strong class="text-dark">Valor:</strong> <span class="text-danger fw-semibold">{{
            tituloSelecionadoTratativas.valor | currency:'BRL' }}</span>
        </div>
        <div class="col-6 text-end mt-2">
          <span class="badge status-badge bg-{{tituloSelecionadoTratativas.statusColor}} bg-opacity-10 text-{{tituloSelecionadoTratativas.statusColor}}">{{ tituloSelecionadoTratativas.status }}</span>
        </div>
      </div>
    </div>

    <!-- Timeline / Lista de Tratativas -->
    <div class="tratativas-list">
      <div *ngfor="let tratativa of tratativasMock; let isLast = last" class="mb-3">
        <div class="d-flex justify-content-between mb-1">
          <span class="fw-semibold text-dark" style="font-size: 0.9rem;">
            <i class="fa-solid fa-user-circle text-secondary me-1"></i> {{ tratativa.autor }}
          </span>
          <span class="text-muted" style="font-size: 0.8rem;">
            <i class="fa-regular fa-clock me-1"></i> {{ tratativa.data | date:'dd/MM/yyyy HH:mm' }}
          </span>
        </div>
        <div class="p-3 bg-light rounded-3 text-secondary border border-1" style="font-size: 0.9rem; line-height: 1.5; border-color: #f1f5f9 !important;">
          {{ tratativa.conteudo }}
        </div>
      </div>

      <div *ngif="tratativasMock.length === 0" class="text-center text-muted py-4">
        Nenhuma tratativa registrada para este título.
      </div>
    </div>
  </div>

  <div modal-footer class="w-100 d-flex justify-content-end gap-2 px-3 py-2">
    <app-button variant="ghost" (clicked)="fecharTratativas()">Fechar</app-button>
    <app-button variant="primary"><i class="fa-solid fa-plus me-2"></i>Nova Tratativa</app-button>
  </div>
</app-modal>

<!-- Modal Histórico -->
<app-modal [isopen]="isHistoricoModalOpen" [title]="'Histórico do Título ' + (tituloSelecionadoHistorico?.titulo || '')" size="md" (closed)="fecharHistorico()">

  <div class="p-2">
    <div *ngif="tituloSelecionadoHistorico" class="mb-4 pb-3 border-bottom">
      <div class="row text-muted" style="font-size: 0.9rem;">
        <div class="col-6">
          <strong class="text-dark">Cliente:</strong> {{ tituloSelecionadoHistorico.cliente }}
        </div>
        <div class="col-6 text-end">
          <strong class="text-dark">Vencimento:</strong> {{ tituloSelecionadoHistorico.vencimento |
          date:'dd/MM/yyyy' }}
        </div>
        <div class="col-6 mt-2">
          <strong class="text-dark">Valor:</strong> <span class="text-danger fw-semibold">{{
            tituloSelecionadoHistorico.valor | currency:'BRL' }}</span>
        </div>
      </div>
    </div>

    <!-- Timeline Vertical Premium -->
    <div class="historico-timeline mt-3">

      <ng-container *ngfor="let item of historicoMock; let i = index; let isLast = last">
        <div class="historico-timeline-item" [class.last]="isLast">
          <!-- Ícone colorido baseado no tipo do evento -->
          <div class="historico-timeline-icon" [ngclass]="{
              'icon-success': item.tipo?.toLowerCase().includes('finaliz') || item.tipo?.toLowerCase().includes('resolu'),
              'icon-warning': item.tipo?.toLowerCase().includes('prorrogad'),
              'icon-info':    item.tipo?.toLowerCase().includes('classifica') || item.tipo?.toLowerCase().includes('fase'),
              'icon-primary': item.tipo?.toLowerCase().includes('importad') || item.tipo?.toLowerCase().includes('email'),
              'icon-purple':  item.tipo?.toLowerCase().includes('tratativa'),
              'icon-secondary': !item.tipo?.toLowerCase().includes('finaliz') && !item.tipo?.toLowerCase().includes('resolu') && !item.tipo?.toLowerCase().includes('prorrogad') && !item.tipo?.toLowerCase().includes('classifica') && !item.tipo?.toLowerCase().includes('importad') && !item.tipo?.toLowerCase().includes('email') && !item.tipo?.toLowerCase().includes('tratativa')
            }">
            <i [ngclass]="{
              'fa-solid fa-check-circle':     item.tipo?.toLowerCase().includes('finaliz') || item.tipo?.toLowerCase().includes('resolu'),
              'fa-regular fa-calendar-plus':  item.tipo?.toLowerCase().includes('prorrogad'),
              'fa-solid fa-shuffle':          item.tipo?.toLowerCase().includes('classifica') || item.tipo?.toLowerCase().includes('fase'),
              'fa-solid fa-file-circle-plus': item.tipo?.toLowerCase().includes('importad'),
              'fa-solid fa-envelope':         item.tipo?.toLowerCase().includes('email'),
              'fa-solid fa-headset':          item.tipo?.toLowerCase().includes('tratativa'),
              'fa-solid fa-circle-info':      !item.tipo?.toLowerCase().includes('finaliz') && !item.tipo?.toLowerCase().includes('resolu') && !item.tipo?.toLowerCase().includes('prorrogad') && !item.tipo?.toLowerCase().includes('classifica') && !item.tipo?.toLowerCase().includes('importad') && !item.tipo?.toLowerCase().includes('email') && !item.tipo?.toLowerCase().includes('tratativa')
            }"></i>
          </div>

          <!-- Conteúdo -->
          <div class="historico-timeline-content">
            <div class="d-flex align-items-center justify-content-between mb-1 flex-wrap gap-1">
              <span class="fw-semibold" style="font-size: 0.9rem; color: #1e293b;">{{ item.tipo }}</span>
              <span class="text-muted" style="font-size: 0.78rem;">
                <i class="fa-regular fa-clock me-1"></i>{{ item.data | date:'dd/MM/yyyy HH:mm' }}
              </span>
            </div>
            <div *ngif="item.fase || item.status" class="mb-1 d-flex gap-1 flex-wrap">
              <span *ngif="item.fase" class="badge rounded-pill px-2 py-1" style="font-size: 0.72rem; font-weight: 500; background: rgba(59,130,246,0.1); color: #3b82f6; border: 1px solid rgba(59,130,246,0.2);">
                {{ item.fase }}
              </span>
              <span *ngif="item.status" class="badge rounded-pill px-2 py-1" style="font-size: 0.72rem; font-weight: 500; background: rgba(100,116,139,0.12); color: #475569; border: 1px solid rgba(100,116,139,0.2);">
                {{ item.status }}
              </span>
            </div>
            <p *ngif="item.descricao" class="mb-0 text-muted" style="font-size: 0.84rem; line-height: 1.5;">{{ item.descricao }}</p>
          </div>
        </div>
      </ng-container>

      <div *ngif="historicoMock.length === 0" class="text-center text-muted py-5">
        <i class="fa-regular fa-clock-rotate-left mb-2 d-block" style="font-size: 2rem; opacity:0.3;"></i>
        Nenhum registro de histórico para este título.
      </div>
    </div>
  </div>

  <div modal-footer class="w-100 d-flex justify-content-end px-3 py-2">
    <app-button variant="ghost" (clicked)="fecharHistorico()">Fechar</app-button>
  </div>
</app-modal>

<!-- Modal de Confirmação Genérico -->
<app-confirm-modal [isopen]="isConfirmModalOpen" [title]="confirmTitle" [message]="confirmMessage" [variant]="confirmVariant" [confirmtext]="confirmText" [canceltext]="cancelText" [showcancel]="showCancelConfirm" (confirmed)="confirmCallback()" (canceled)="closeConfirmModal()">
</app-confirm-modal>